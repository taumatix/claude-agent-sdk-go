{
    "enabledPlugins": {
    "developer@taumatix-dev": true,
    "git@taumatix-dev": true
  },
  "extraKnownMarketplaces": {
    "taumatix-dev": {
      "source": {
        "source": "github",
        "repo": "taumatix/dev"
      },
      "autoUpdate": true
    }
  },
  "rules": [
    {
      "glob": "**/*.go",
      "path": "rules/go_rule.md"
    },
    {
      "glob": "**/*_test.go",
      "path": "rules/go_test_rule.md"
    }
  ]
}
